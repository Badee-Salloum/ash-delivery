# ASH Delivery — environment template.
# Copy to .env.staging / .env.prod, fill in, then encrypt with SOPS: `sops -e -i .env.prod`
# The plaintext files are gitignored; only the .enc versions are ever committed.

# ── compose ──────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ash-staging
# Pinned by DIGEST, never by tag — a tag can be moved, a digest cannot.
API_IMAGE=ghcr.io/OWNER/ash-delivery/api@sha256:...

# ── database ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=ash
POSTGRES_PASSWORD=
POSTGRES_DB=ash

# ── application ──────────────────────────────────────────────────────────────────────────
# The API refuses to start in production without this.
DATABASE_URL=postgres://ash:PASSWORD@postgres:5432/ash
BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Asia/Damascus is UTC+3 year-round since October 2022.
TZ_OFFSET_MINUTES=180

# BR1's component gate. Keep `advisory` until the equation has been calibrated against a REAL
# Yallago shift (RUNBOOK §1) — flipping to `strict` before then will make shifts unclosable.
BR1_SPLIT_GATE=advisory

# AES-256-GCM key for PII at rest (a driver's national ID). 32 bytes as 64 hex chars.
# Generate with: openssl rand -hex 32
# Optional — WITHOUT it the app runs, but storing a national ID is refused (never plaintext).
# LOSING this key makes stored national IDs unrecoverable; back it up separately from the DB.
ENCRYPTION_KEY=

# ── backups ──────────────────────────────────────────────────────────────────────────────
RESTIC_REPOSITORY=b2:ash-backups:/staging
# Custody is SEPARATE from the SOPS age key. A backup you cannot decrypt is not a backup.
RESTIC_PASSWORD=
RETENTION_DAYS=90
BACKUP_HOUR=2

# ── edge (Caddy) ─────────────────────────────────────────────────────────────────────────
ACME_EMAIL=
PROD_DOMAIN=
STAGING_DOMAIN=
STAGING_USER=
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
STAGING_PASSWORD_HASH=

# ── Cloud OCR ────────────────────────────────────────────────────────────────────────────────
# The reader that transcribes money off driver screenshots. `none` is the DEFAULT and the kill
# switch: flip it and every read falls back to the on-device reader with no code deploy.
# Each driver reads only its OWN key, and the boot refuses the pair without it.
OCR_DRIVER=none                                     # none | openai | openrouter

# The measured production reader (5 misreads / 319 rows; never disagreed with itself across three
# passes). Thinking is deliberately UNCAPPED — capping it introduced money self-disagreement.
OPENROUTER_API_KEY=
OPENROUTER_OCR_MODEL=google/gemini-3.7-flash

# The revert reader. 26-34 misreads and it disagreed with itself on 14 of 48 images; kept because a
# second, independent provider is worth having when the first one is down.
OPENAI_API_KEY=
OPENAI_OCR_MODEL=gpt-5.4
OPENAI_OCR_EFFORT=default                           # default omits the field. OpenAI only.
OPENAI_OCR_VERBOSITY=default                        # default omits the field. OpenAI only.

# Strictly BELOW vercel.json's 60s function ceiling, so a slow read returns a clean timeout instead
# of the socket dying at the same instant the platform gives up.
OCR_TIMEOUT_MS=50000
OCR_MAX_READS_PER_SHIFT=15                          # runaway guard, not a business rule
