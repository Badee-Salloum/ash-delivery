# ASH Delivery — environment template.
# Copy to .env.staging / .env.prod, fill in, then encrypt with SOPS: `sops -e -i .env.prod`
# The plaintext files are gitignored; only the .enc versions are ever committed.

# ── compose ──────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=ash-staging
# Pinned by DIGEST, never by tag — a tag can be moved, a digest cannot.
API_IMAGE=ghcr.io/OWNER/ash-delivery/api@sha256:...

# ── database ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=ash
POSTGRES_PASSWORD=
POSTGRES_DB=ash

# ── application ──────────────────────────────────────────────────────────────────────────
# The API refuses to start in production without this.
DATABASE_URL=postgres://ash:PASSWORD@postgres:5432/ash
BCRYPT_ROUNDS=12
LOG_LEVEL=info

# Asia/Damascus is UTC+3 year-round since October 2022.
TZ_OFFSET_MINUTES=180

# BR1's component gate. Keep `advisory` until the equation has been calibrated against a REAL
# Yallago shift (RUNBOOK §1) — flipping to `strict` before then will make shifts unclosable.
BR1_SPLIT_GATE=advisory

# ── backups ──────────────────────────────────────────────────────────────────────────────
RESTIC_REPOSITORY=b2:ash-backups:/staging
# Custody is SEPARATE from the SOPS age key. A backup you cannot decrypt is not a backup.
RESTIC_PASSWORD=
RETENTION_DAYS=90
BACKUP_HOUR=2

# ── edge (Caddy) ─────────────────────────────────────────────────────────────────────────
ACME_EMAIL=
PROD_DOMAIN=
STAGING_DOMAIN=
STAGING_USER=
# Generate with: docker run --rm caddy:2 caddy hash-password --plaintext 'yourpassword'
STAGING_PASSWORD_HASH=
